Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: odom
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: WheelOdometry
      Topic:
        Value: /diff_drive_controller/odom
      Keep: 200
      Position Tolerance: 0.01
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Alpha: 1
        Head Length: 0.1
        Head Radius: 0.06
        Shaft Length: 0.15
        Shaft Radius: 0.03
      Covariance:
        Position:
          Value: true
        Orientation:
          Value: false
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Near Clip Distance: 0.01
Window Geometry:
  Height: 900
  Width: 1600
  X: 60
  Y: 60
